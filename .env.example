# ── Auth ──────────────────────────────────────────────────────────────────
# Bearer estático: protege /refresh, /reload siempre y /mcp si OAuth está off.
# MCP_API_KEY=cambia-esto-por-un-secreto-largo

# ── OAuth 2.1 para /mcp (WorkOS AuthKit) — opcional ────────────────────────
# Si defines AUTHKIT_DOMAIN + BASE_URL, /mcp usa OAuth (DCR) en vez del bearer.
# AUTHKIT_DOMAIN=https://tu-proyecto.authkit.app
# BASE_URL=https://sat69-mcp.onrender.com

# ── Base de datos ──────────────────────────────────────────────────────────
# Local: default <repo>/data/sat69.db. En Render: /tmp/sat69.db (efímero).
# DB_PATH=/absolute/path/to/sat69.db

# ── Turso (persistencia durable) ───────────────────────────────────────────
# TURSO_DATABASE_URL=libsql://tu-db.turso.io
# TURSO_AUTH_TOKEN=

# ── Proxy SOLO para descargar del SAT (opcional) ───────────────────────────
# En pruebas el SAT no bloquea IPs de datacenter, así que normalmente NO hace
# falta. Se conserva por paridad con el MCP de movilizaciones.
# Opción 1 — URL completa:
# FETCH_PROXY=http://usuario:password@gateway:puerto
# Opción 2 — credenciales DataImpulse (arma la URL con targeting de país):
# DATAIMPULSE_USER=...
# DATAIMPULSE_PASS=...
# DATAIMPULSE_HOST=gw.dataimpulse.com
# DATAIMPULSE_PORT=823
# DATAIMPULSE_COUNTRY=mx

# ── Despliegue / tuning ────────────────────────────────────────────────────
# FETCH_ON_STARTUP=true
# HOST=0.0.0.0
# PORT=8080
# DOWNLOAD_TIMEOUT=180
# CHUNK_SIZE=1000
# LOG_LEVEL=INFO
